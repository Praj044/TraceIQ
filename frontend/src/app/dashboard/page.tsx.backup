"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { motion, useReducedMotion } from "motion/react";
import {
  Activity,
  ArrowRight,
  ArrowUpRight,
  CheckCircle2,
  CircleAlert,
  Clock3,
  Download,
  FolderKanban,
  Gauge,
  GitCompareArrows,
  LayoutDashboard,
  Terminal,
} from "lucide-react";
import { ThemeToggle } from "../components/theme-toggle";
import { apiGet } from "@/app/lib/api";
import { AuthGuard } from "@/app/components/auth-guard";
import {
  ResponsiveContainer, BarChart, Bar, LineChart, Line,
  PieChart, Pie, Cell, XAxis, YAxis, CartesianGrid, Tooltip, Legend,
} from "recharts";

type Project = {
  id: string;
  name: string;
  description: string | null;
  base_url: string | null;
  created_at: string;
};

type ProjectSummary = {
  project_id: string;
  total_runs: number;
  passed_runs: number;
  failed_runs: number;
  pass_rate_percent: number;
  average_response_time_ms: number | null;
  last_run_at: string | null;
};

type ActivityItem = {
  projectName: string;
  projectId: string;
  lastRunAt: string;
  totalRuns: number;
  failedRuns: number;
};
type Regression = {
  test_case_id: string;
  test_name: string;
  latest_run_id: string;
  previous_run_id: string;
  latest_passed: boolean;
  previous_passed: boolean;
  previous_response_time_ms: number | null;
  latest_response_time_ms: number | null;
  reasons: string[];
  detected_at: string;
};

type RegressionResponse = {
  project_id: string;
  regression_count: number;
  regressions: Regression[];
};

type ProjectRegression = Regression & {
  projectName: string;
  projectId: string;
};

type ExecutionHistoryItem = {
  run_id: string;
  test_case_id: string;
  test_name: string;
  passed: boolean;
  expected_status: number | null;
  actual_status: number | null;
  response_time_ms: number | null;
  error: string | null;
  assertion_results: unknown;
  created_at: string;
};

type ExecutionHistoryResponse = {
  project_id: string;
  total: number;
  limit: number;
  offset: number;
  history: ExecutionHistoryItem[];
};

type ProjectExecution = ExecutionHistoryItem & {
  projectName: string;
  projectId: string;
};

function formatResponseTime(value: number | null) {
  if (value === null || !Number.isFinite(value)) {
    return "—";
  }

  return `${value.toFixed(2)} ms`;
}

function formatDate(value: string) {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Unknown date";
  }

  return date.toLocaleString(undefined, {
    dateStyle: "medium",
    timeStyle: "short",
  });
}

function MetricCard({
  label,
  value,
  detail,
  index,
  icon: Icon,
  accent = "emerald",
}: {
  label: string;
  value: string;
  detail: string;
  index: number;
  icon: typeof Activity;
  accent?: "emerald" | "blue" | "amber" | "violet";
}) {
  const reduceMotion = useReducedMotion();

  const accentClasses = {
    emerald: "bg-emerald-500/10 text-emerald-500",
    blue: "bg-sky-500/10 text-sky-500",
    amber: "bg-amber-500/10 text-amber-500",
    violet: "bg-violet-500/10 text-violet-500",
  };

  return (
    <motion.article
      initial={reduceMotion ? false : { opacity: 0, y: 18 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{
        duration: 0.45,
        delay: index * 0.08,
        ease: "easeOut",
      }}
      whileHover={reduceMotion ? undefined : { y: -5 }}
      className="group relative overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 transition-colors duration-300 hover:border-emerald-500/40 sm:p-6"
    >
      <div className="pointer-events-none absolute -right-8 -top-8 h-28 w-28 rounded-full bg-emerald-500/10 opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-100" />

      <div className="relative flex items-start justify-between gap-3">
        <p className="text-sm text-[var(--muted)]">{label}</p>
        <div className={`rounded-xl p-2.5 ${accentClasses[accent]}`}>
          <Icon size={19} />
        </div>
      </div>

      <p className="relative mt-5 break-words text-3xl font-semibold tracking-tight sm:text-4xl">
        {value}
      </p>

      <p className="relative mt-2 text-xs leading-5 text-[var(--muted)]">
        {detail}
      </p>
    </motion.article>
  );
}

function SectionHeading({
  eyebrow,
  title,
  description,
}: {
  eyebrow: string;
  title: string;
  description: string;
}) {
  return (
    <div className="mb-5">
      <p className="mb-2 font-mono text-[10px] font-medium uppercase tracking-[0.2em] text-emerald-500">
        {eyebrow}
      </p>
      <h3 className="text-lg font-semibold tracking-tight">{title}</h3>
      <p className="mt-1 text-sm leading-6 text-[var(--muted)]">
        {description}
      </p>
    </div>
  );
}

export default function Home() {
  const reduceMotion = useReducedMotion();

  const [projects, setProjects] = useState<Project[]>([]);
  const [summaries, setSummaries] = useState<ProjectSummary[]>([]);
  const [regressions, setRegressions] = useState<ProjectRegression[]>([]);
  const [regressionsLoading, setRegressionsLoading] = useState(true);
  const [executionHistory, setExecutionHistory] = useState<ProjectExecution[]>([]);
  const [historyLoading, setHistoryLoading] = useState(true);
  const [loading, setLoading] = useState(true);
  const [analyticsLoading, setAnalyticsLoading] = useState(true);
  const [error, setError] = useState("");
  const [analyticsError, setAnalyticsError] = useState("");

  useEffect(() => {
    let active = true;

    async function loadDashboard() {
      setLoading(true);
      setAnalyticsLoading(true);
      setError("");
      setAnalyticsError("");

      try {
        const projectData = await apiGet<Project[]>("/api/v1/projects");

        if (!active) return;

        setProjects(projectData);
        setLoading(false);

        const results = await Promise.allSettled(
          projectData.map(async (project) => {
            return await apiGet<ProjectSummary>(
                `/api/v1/projects/${project.id}/test-runs/summary`,
            );
          }),
        );

        if (!active) return;

        const successfulSummaries = results
          .filter(
            (
              result,
            ): result is PromiseFulfilledResult<ProjectSummary> =>
              result.status === "fulfilled",
          )
          .map((result) => result.value);

        setSummaries(successfulSummaries);
        const regressionResults = await Promise.allSettled(
          projectData.map(async (project) => {
            const result = await apiGet<RegressionResponse>(
              `/api/v1/projects/${project.id}/test-runs/regressions`,
            );

            return result.regressions.map((regression) => ({
              ...regression,
              projectName: project.name,
              projectId: project.id,
            }));
          }),
        );

        if (!active) return;

        const allRegressions = regressionResults
          .filter(
            (result): result is PromiseFulfilledResult<ProjectRegression[]> =>
              result.status === "fulfilled",
          )
          .flatMap((result) => result.value)
          .sort(
            (a, b) =>
              new Date(b.detected_at).getTime() -
              new Date(a.detected_at).getTime(),
          );

        setRegressions(allRegressions);
        setRegressionsLoading(false);

        const historyResults = await Promise.allSettled(
          projectData.map(async (project) => {
            const result = await apiGet<ExecutionHistoryResponse>(
              `/api/v1/projects/${project.id}/test-runs/history?limit=50&offset=0`,
            );
            return result.history.map((run) => ({
              ...run,
              projectName: project.name,
              projectId: project.id,
            }));
          }),
        );

        if (!active) return;

        const allExecutions = historyResults
          .filter(
            (result): result is PromiseFulfilledResult<ProjectExecution[]> =>
              result.status === "fulfilled",
          )
          .flatMap((result) => result.value)
          .sort(
            (a, b) =>
              new Date(b.created_at).getTime() -
              new Date(a.created_at).getTime(),
          )
          .slice(0, 20);

        setExecutionHistory(allExecutions);
        setHistoryLoading(false);

        if (results.some((result) => result.status === "rejected")) {
          setAnalyticsError(
            "Some project summaries could not be loaded. Displayed metrics may be incomplete.",
          );
        }
      } catch {
        if (active) {
          setError(
            "Could not load projects. Check that FastAPI is running and the API URL is correct.",
          );
        }
      } finally {
        if (active) {
          setLoading(false);
          setAnalyticsLoading(false);
          setRegressionsLoading(false);
          setHistoryLoading(false);
        }
      }
    }

    loadDashboard();

    return () => {
      active = false;
    };
  }, []);

  // Aggregate analytics from the real backend summaries.
  const totalRuns = summaries.reduce(
    (total, summary) => total + summary.total_runs,
    0,
  );

  const passedRuns = summaries.reduce(
    (total, summary) => total + summary.passed_runs,
    0,
  );

  const failedRuns = summaries.reduce(
    (total, summary) => total + summary.failed_runs,
    0,
  );

  const passRate =
    totalRuns > 0
      ? `${((passedRuns / totalRuns) * 100).toFixed(2)}%`
      : "—";

  const summariesWithResponseTime = summaries.filter(
    (summary) => summary.average_response_time_ms !== null,
  );

  const responseTimeWeight = summariesWithResponseTime.reduce(
    (total, summary) => total + summary.total_runs,
    0,
  );

  const averageResponseTime =
    responseTimeWeight > 0
      ? summariesWithResponseTime.reduce(
          (total, summary) =>
            total +
            (summary.average_response_time_ms ?? 0) * summary.total_runs,
          0,
        ) / responseTimeWeight
      : null;


  const passFailChartData = [
    { name: "Passed", value: passedRuns },
    { name: "Failed", value: failedRuns },
  ];

  const dailyExecutionData = (() => {
    const grouped = new Map<string, {
      date: string; passed: number; failed: number;
      responseTotal: number; responseCount: number;
    }>();

    executionHistory.forEach((run) => {
      const date = new Date(run.created_at);
      if (Number.isNaN(date.getTime())) return;
      const key = date.toISOString().slice(0, 10);

      if (!grouped.has(key)) {
        grouped.set(key, {
          date: key, passed: 0, failed: 0,
          responseTotal: 0, responseCount: 0,
        });
      }

      const entry = grouped.get(key)!;
      run.passed ? entry.passed++ : entry.failed++;

      if (run.response_time_ms !== null && Number.isFinite(run.response_time_ms)) {
        entry.responseTotal += run.response_time_ms;
        entry.responseCount++;
      }
    });

    return Array.from(grouped.values())
      .sort((a, b) => a.date.localeCompare(b.date))
      .map((entry) => ({
        date: new Date(entry.date + "T00:00:00").toLocaleDateString(
          undefined, { month: "short", day: "numeric" }
        ),
        passed: entry.passed,
        failed: entry.failed,
        avgResponseTime: entry.responseCount
          ? Number((entry.responseTotal / entry.responseCount).toFixed(2))
          : null,
      }));
  })();

  const stats = [
    {
      label: "Total test runs",
      value: analyticsLoading ? "…" : String(totalRuns),
      detail: "Across loaded projects",
      icon: Activity,
      accent: "emerald" as const,
    },
    {
      label: "Pass rate",
      value: analyticsLoading ? "…" : passRate,
      detail: `${passedRuns} successful runs`,
      icon: CheckCircle2,
      accent: "blue" as const,
    },
    {
      label: "Failed tests",
      value: analyticsLoading ? "…" : String(failedRuns),
      detail: "Runs that need investigation",
      icon: CircleAlert,
      accent: "amber" as const,
    },
    {
      label: "Avg. response",
      value: analyticsLoading
        ? "…"
        : formatResponseTime(averageResponseTime),
      detail: "Based on project summaries",
      icon: Gauge,
      accent: "violet" as const,
    },
  ];

  // Keep activity derived from the latest available project summaries.
  const activity: ActivityItem[] = projects
    .map((project) => {
      const summary = summaries.find(
        (item) => item.project_id === project.id,
      );

      if (!summary?.last_run_at) return null;

      return {
        projectName: project.name,
        projectId: project.id,
        lastRunAt: summary.last_run_at,
        totalRuns: summary.total_runs,
        failedRuns: summary.failed_runs,
      };
    })
    .filter((item): item is ActivityItem => item !== null)
    .sort(
      (a, b) =>
        new Date(b.lastRunAt).getTime() -
        new Date(a.lastRunAt).getTime(),
    )
    .slice(0, 5);

  return (
    <AuthGuard>
    <main className="min-h-screen bg-[var(--background)] text-[var(--foreground)]">
      <div className="flex min-h-screen">
        {/* Sidebar */}
        <aside className="hidden w-64 shrink-0 border-r border-[var(--border)] bg-[var(--surface)] p-5 md:flex md:flex-col lg:p-6">
          <Link href="/" className="flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20">
              <Activity size={21} strokeWidth={2.5} />
            </div>
            <div>
              <h1 className="text-xl font-semibold tracking-tight">
                Trace<span className="text-emerald-500">IQ</span>
              </h1>
              <p className="text-xs text-[var(--muted)]">
                API intelligence
              </p>
            </div>
          </Link>

          <p className="mb-3 mt-10 px-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">
            Workspace
          </p>

          <nav className="space-y-1.5">
            <a
              href="#overview"
              className="flex items-center gap-3 rounded-xl border border-emerald-500/10 bg-emerald-500/10 px-3 py-3 text-sm font-medium text-emerald-600 dark:text-emerald-300"
            >
              <LayoutDashboard size={17} />
              Overview
            </a>

            <a
              href="#projects"
              className="flex items-center gap-3 rounded-xl px-3 py-3 text-sm text-[var(--muted)] transition hover:bg-[var(--surface-raised)] hover:text-[var(--foreground)]"
            >
              <FolderKanban size={17} />
              Projects
            </a>

            <a
              href="#tests"
              className="flex items-center gap-3 rounded-xl px-3 py-3 text-sm text-[var(--muted)] transition hover:bg-[var(--surface-raised)] hover:text-[var(--foreground)]"
            >
              <GitCompareArrows size={17} />
              Test analytics
            </a>

            <a
              href="#activity"
              className="flex items-center gap-3 rounded-xl px-3 py-3 text-sm text-[var(--muted)] transition hover:bg-[var(--surface-raised)] hover:text-[var(--foreground)]"
            >
              <Clock3 size={17} />
              Activity
            </a>
            <a
              href="#regressions"
              className="flex items-center gap-3 rounded-xl px-3 py-3 text-sm text-[var(--muted)] transition hover:bg-[var(--surface-raised)] hover:text-[var(--foreground)]"
            >
              <CircleAlert size={17} />
              Regressions
            </a>
          </nav>

          <div className="mt-auto rounded-2xl border border-[var(--border)] bg-[var(--surface-raised)] p-4">
            <div className="mb-2 flex items-center gap-2">
              <span className="relative flex h-2 w-2">
                <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50" />
                <span className="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
              </span>
              <p className="text-sm font-medium">Local environment</p>
            </div>
            <p className="text-xs leading-5 text-[var(--muted)]">
              TraceIQ API testing workspace
            </p>
            <div className="mt-3 flex items-center gap-2 text-xs text-emerald-600 dark:text-emerald-300">
              <Terminal size={13} />
              API workspace
            </div>
          </div>
        </aside>

        {/* Main workspace */}
        <section id="overview" className="min-w-0 flex-1">
          <header className="sticky top-0 z-30 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border)] bg-[var(--background)]/85 px-5 py-4 backdrop-blur-xl sm:px-8">
            <div>
              <p className="text-xs text-[var(--muted)]">
                Workspace / Overview
              </p>
              <h2 className="mt-1 text-xl font-semibold tracking-tight">
                Dashboard
              </h2>
            </div>

            <div className="flex items-center gap-3">
              <span className="flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-2 text-xs font-medium text-emerald-600 dark:text-emerald-300">
                <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500" />
                API testing
              </span>
              <ThemeToggle />
            </div>
          </header>

          <div className="mx-auto max-w-7xl space-y-8 p-5 sm:p-8">
            {/* Welcome panel */}
            <motion.section
              initial={reduceMotion ? false : { opacity: 0, y: 15 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.55 }}
              className="relative isolate overflow-hidden rounded-3xl border border-emerald-500/20 bg-gradient-to-br from-emerald-950 via-[#10251d] to-[var(--surface)] p-6 text-white sm:p-9"
            >
              <div className="pointer-events-none absolute -right-20 -top-24 -z-10 h-72 w-72 rounded-full bg-emerald-400/20 blur-3xl" />
              <div className="pointer-events-none absolute bottom-0 right-0 -z-10 h-40 w-2/3 bg-gradient-to-l from-emerald-400/5 to-transparent" />

              <div className="relative max-w-2xl">
                <span className="inline-flex items-center gap-2 rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1.5 text-xs font-medium text-emerald-200">
                  <Activity size={13} />
                  API quality, at a glance
                </span>

                <h3 className="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
                  Know when your APIs{" "}
                  <span className="text-emerald-400">break.</span>
                </h3>

                <p className="mt-3 max-w-xl text-sm leading-7 text-emerald-50/70 sm:text-base">
                  Import an OpenAPI specification, run your test cases, and
                  inspect test history and regressions from one developer
                  workspace.
                </p>

                <a
                  href="#projects"
                  className="mt-6 inline-flex items-center gap-2 rounded-xl bg-emerald-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-emerald-300"
                >
                  Explore projects
                  <ArrowRight size={16} />
                </a>
              </div>

              <div className="relative mt-8 flex flex-wrap gap-2 sm:absolute sm:bottom-8 sm:right-8 sm:mt-0 sm:justify-end">
                <div className="flex items-center gap-2 rounded-xl border border-white/10 bg-black/15 px-3 py-2 backdrop-blur-md">
                  <CheckCircle2 size={15} className="text-emerald-300" />
                  <span className="text-xs text-white/80">
                    Test execution
                  </span>
                </div>
                <div className="flex items-center gap-2 rounded-xl border border-white/10 bg-black/15 px-3 py-2 backdrop-blur-md">
                  <GitCompareArrows size={15} className="text-emerald-300" />
                  <span className="text-xs text-white/80">
                    Regression insights
                  </span>
                </div>
              </div>
            </motion.section>

            {/* Analytics */}
            <section id="tests">
              <SectionHeading
                eyebrow="Live analytics"
                title="Testing overview"
                description="Metrics calculated from the project summaries returned by your backend."
              />

              {analyticsError && (
                <p
                  role="status"
                  className="mb-4 rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 text-sm text-amber-600 dark:text-amber-200"
                >
                  {analyticsError}
                </p>
              )}

              <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                {stats.map((stat, index) => (
                  <MetricCard
                    key={stat.label}
                    label={stat.label}
                    value={stat.value}
                    detail={stat.detail}
                    index={index}
                    icon={stat.icon}
                    accent={stat.accent}
                  />
                ))}
              </div>
            
              {/* TraceIQ analytics charts */}
              <div className="mt-6 grid gap-5 xl:grid-cols-2">
                <article className="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5">
                  <h3 className="mb-1 font-semibold">Pass / Fail distribution</h3>
                  <p className="mb-4 text-xs text-[var(--muted)]">Overall test outcomes</p>
                  {totalRuns === 0 ? (
                    <div className="flex h-64 items-center justify-center text-sm text-[var(--muted)]">
                      Run tests to see results.
                    </div>
                  ) : (
                    <ResponsiveContainer width="100%" height={260}>
                      <PieChart>
                        <Pie data={passFailChartData} dataKey="value" nameKey="name"
                          innerRadius={65} outerRadius={95} paddingAngle={4}>
                          <Cell fill="#10b981" />
                          <Cell fill="#f87171" />
                        </Pie>
                        <Tooltip />
                        <Legend />
                      </PieChart>
                    </ResponsiveContainer>
                  )}
                </article>

                <article className="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5">
                  <h3 className="mb-1 font-semibold">Execution volume</h3>
                  <p className="mb-4 text-xs text-[var(--muted)]">Daily passed and failed runs</p>
                  {dailyExecutionData.length === 0 ? (
                    <div className="flex h-64 items-center justify-center text-sm text-[var(--muted)]">
                      Run tests to populate this chart.
                    </div>
                  ) : (
                    <ResponsiveContainer width="100%" height={260}>
                      <BarChart data={dailyExecutionData}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="date" />
                        <YAxis allowDecimals={false} />
                        <Tooltip />
                        <Legend />
                        <Bar dataKey="passed" name="Passed" fill="#10b981" />
                        <Bar dataKey="failed" name="Failed" fill="#f87171" />
                      </BarChart>
                    </ResponsiveContainer>
                  )}
                </article>

                <article className="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 xl:col-span-2">
                  <h3 className="mb-1 font-semibold">Response-time trend</h3>
                  <p className="mb-4 text-xs text-[var(--muted)]">Average daily API response time (ms)</p>
                  {dailyExecutionData.length === 0 ? (
                    <div className="flex h-64 items-center justify-center text-sm text-[var(--muted)]">
                      Run tests to see response times.
                    </div>
                  ) : (
                    <ResponsiveContainer width="100%" height={280}>
                      <LineChart data={dailyExecutionData}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="date" />
                        <YAxis unit=" ms" />
                        <Tooltip />
                        <Line type="monotone" dataKey="avgResponseTime"
                          name="Average response time" stroke="#8b5cf6"
                          strokeWidth={3} connectNulls />
                      </LineChart>
                    </ResponsiveContainer>
                  )}
                </article>
              </div>
</section>
            {/* Regression alerts */}
          <section id="regressions">
            <SectionHeading
              eyebrow="Regression intelligence"
              title="Detected regressions"
              description="Tests that have recently failed or experienced significant response-time degradation."
            />

            <div className="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6">
              {regressionsLoading ? (
                <div className="space-y-3">
                  {[1, 2].map((item) => (
                    <div
                      key={item}
                      className="h-20 animate-pulse rounded-xl bg-[var(--surface-raised)]"
                    />
                  ))}
                </div>
              ) : regressions.length === 0 ? (
                <div className="flex min-h-36 flex-col items-center justify-center text-center">
                  <CheckCircle2 className="text-emerald-500" size={30} />
                  <h4 className="mt-3 font-medium">No regressions detected</h4>
                  <p className="mt-1 text-sm text-[var(--muted)]">
                    Your latest test runs show no detected regressions.
                  </p>
                </div>
              ) : (
                <div className="space-y-3">
                  {regressions.map((regression) => (
                    <Link
                      key={regression.latest_run_id}
                      href={`/projects/${regression.projectId}`}
                      className="block rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 transition hover:border-amber-500/40"
                    >
                      <div className="flex flex-wrap items-start justify-between gap-3">
                        <div>
                          <div className="flex items-center gap-2">
                            <CircleAlert size={16} className="text-amber-500" />
                            <h4 className="font-medium">
                              {regression.test_name}
                            </h4>
                          </div>

                          <p className="mt-1 text-xs text-[var(--muted)]">
                            Project: {regression.projectName}
                          </p>
                        </div>

                        <span className="rounded-full bg-amber-500/10 px-3 py-1 text-xs font-medium text-amber-600 dark:text-amber-300">
                          Regression detected
                        </span>
                      </div>

                      <div className="mt-3 space-y-1.5">
                        {regression.reasons.map((reason, index) => (
                          <p
                            key={index}
                            className="text-sm leading-6 text-[var(--foreground)]"
                          >
                            • {reason}
                          </p>
                        ))}
                      </div>

                      {regression.previous_response_time_ms !== null &&
                        regression.latest_response_time_ms !== null && (
                          <div className="mt-3 flex flex-wrap gap-4 border-t border-[var(--border)] pt-3 text-xs text-[var(--muted)]">
                            <span>
                              Previous:{" "}
                              {regression.previous_response_time_ms.toFixed(2)} ms
                            </span>
                            <span>
                              Latest:{" "}
                              {regression.latest_response_time_ms.toFixed(2)} ms
                            </span>
                          </div>
                        )}

                      <p className="mt-3 text-xs text-[var(--muted)]">
                        Detected: {formatDate(regression.detected_at)}
                      </p>
                    </Link>
                  ))}
                </div>
              )}
            </div>
          </section>

            {/* Projects and activity */}

            {/* Recent test executions */}
            <section id="execution-history">
              <SectionHeading
                eyebrow="Execution history"
                title="Recent test executions"
                description="Your latest API test runs across all projects."
              />

              <div className="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)]">
                {historyLoading ? (
                  <div className="space-y-3 p-6">
                    {[1, 2, 3].map((item) => (
                      <div key={item} className="h-12 animate-pulse rounded-xl bg-[var(--surface-raised)]" />
                    ))}
                  </div>
                ) : executionHistory.length === 0 ? (
                  <div className="px-6 py-12 text-center">
                    <Activity className="mx-auto mb-3 text-[var(--muted)]" size={26} />
                    <p className="font-medium">No test executions yet</p>
                    <p className="mt-1 text-sm text-[var(--muted)]">
                      Run an API test to see its history here.
                    </p>
                  </div>
                ) : (
                  <div className="divide-y divide-[var(--border)]">
                    {executionHistory.map((run) => (
                      <div key={run.run_id} className="flex flex-col justify-between gap-3 px-5 py-4 sm:flex-row sm:items-center">
                        <div className="flex min-w-0 items-center gap-3">
                          <div className={`rounded-lg p-2 ${run.passed ? "bg-emerald-500/10 text-emerald-500" : "bg-red-500/10 text-red-500"}`}>
                            {run.passed ? <CheckCircle2 size={17} /> : <CircleAlert size={17} />}
                          </div>
                          <div className="min-w-0">
                            <p className="truncate text-sm font-semibold">{run.test_name}</p>
                            <p className="mt-1 text-xs text-[var(--muted)]">{run.projectName}</p>
                            {run.error && <p className="mt-1 truncate text-xs text-red-500">{run.error}</p>}
                          </div>
                        </div>
                        <div className="flex flex-wrap items-center gap-4 pl-11 text-xs sm:pl-0">
                          <span className={`rounded-full px-2.5 py-1 font-medium ${run.passed ? "bg-emerald-500/10 text-emerald-500" : "bg-red-500/10 text-red-500"}`}>
                            {run.passed ? "PASSED" : "FAILED"}
                          </span>
                          <span className="text-[var(--muted)]">HTTP {run.actual_status ?? "?"}</span>
                          <span className="flex items-center gap-1 text-[var(--muted)]">
                            <Clock3 size={13} />
                            {formatResponseTime(run.response_time_ms)}
                          </span>
                          <span className="text-[var(--muted)]">{formatDate(run.created_at)}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </section>
            <section
              id="projects"
              className="grid items-start gap-5 xl:grid-cols-[1.3fr_0.7fr]"
            >
              <motion.article
                initial={reduceMotion ? false : { opacity: 0, y: 16 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.5, delay: 0.15 }}
                className="min-w-0 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6"
              >
                <div className="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <p className="mb-1 font-mono text-[10px] uppercase tracking-[0.2em] text-emerald-500">
                      Workspace
                    </p>
                    <h3 className="font-semibold">Your projects</h3>
                    <p className="mt-1 text-sm text-[var(--muted)]">
                      API collections under test
                    </p>
                  </div>

                  <span className="rounded-lg border border-[var(--border)] bg-[var(--surface-raised)] px-3 py-2 text-xs text-[var(--muted)]">
                    {loading ? "Loading…" : `${projects.length} projects`}
                  </span>
                </div>

                {error && (
                  <div
                    role="alert"
                    className="mt-6 rounded-xl border border-red-500/20 bg-red-500/5 p-4 text-sm leading-6 text-red-600 dark:text-red-300"
                  >
                    <div className="mb-1 flex items-center gap-2 font-medium">
                      <CircleAlert size={16} />
                      Could not load projects
                    </div>
                    {error}
                  </div>
                )}

                {loading ? (
                  <div className="mt-6 space-y-3">
                    {[1, 2, 3].map((item) => (
                      <div
                        key={item}
                        className="animate-pulse rounded-xl border border-[var(--border)] p-4"
                      >
                        <div className="h-4 w-1/3 rounded bg-[var(--surface-raised)]" />
                        <div className="mt-3 h-3 w-2/3 rounded bg-[var(--surface-raised)]" />
                      </div>
                    ))}
                  </div>
                ) : !error && projects.length === 0 ? (
                  <div className="mt-6 flex min-h-52 flex-col items-center justify-center rounded-xl border border-dashed border-[var(--border)] px-5 text-center">
                    <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-500">
                      <FolderKanban size={22} />
                    </div>
                    <h4 className="mt-4 font-medium">No projects yet</h4>
                    <p className="mt-2 max-w-sm text-sm leading-6 text-[var(--muted)]">
                      Create your first project through your existing TraceIQ
                      project workflow or API.
                    </p>
                  </div>
                ) : !error ? (
                  <div className="mt-6 space-y-3">
                    {projects.map((project, index) => {
                      const summary = summaries.find(
                        (item) => item.project_id === project.id,
                      );
                      const handleExportCSV = () => {
                      if (executionHistory.length === 0) return;

                      const headers = [
                        "Project",
                        "Test Name",
                        "Status",
                        "Expected Status",
                        "Actual Status",
                        "Response Time (ms)",
                        "Error",
                        "Timestamp",
                      ];

                      const escapeCSV = (value: unknown) => {
                        let text = String(value ?? "");

                        // Protect against spreadsheet formula injection.
                        if (/^[=+\-@]/.test(text)) {
                          text = `'${text}`;
                        }

                        return `"${text.replace(/"/g, '""')}"`;
                      };

                      const rows = executionHistory.map((run) => [
                        run.projectName,
                        run.test_name,
                        run.passed ? "PASSED" : "FAILED",
                        run.expected_status,
                        run.actual_status,
                        run.response_time_ms,
                        run.error ?? "",
                        run.created_at,
                      ]);

                      const csvContent = [
                        headers.map(escapeCSV).join(","),
                        ...rows.map((row) => row.map(escapeCSV).join(",")),
                      ].join("\r\n");

                      const blob = new Blob(["\uFEFF" + csvContent], {
                        type: "text/csv;charset=utf-8;",
                      });

                      const url = URL.createObjectURL(blob);
                      const link = document.createElement("a");

                      link.href = url;
                      link.download = `traceiq-history-${new Date()
                        .toISOString()
                        .slice(0, 10)}.csv`;

                      document.body.appendChild(link);
                      link.click();
                      link.remove();

                      URL.revokeObjectURL(url);
                    };

                      return (
                        <motion.div
                          key={project.id}
                          initial={reduceMotion ? false : { opacity: 0, y: 12 }}
                          animate={{ opacity: 1, y: 0 }}
                          transition={{
                            duration: 0.35,
                            delay: index * 0.06,
                          }}
                          whileHover={reduceMotion ? undefined : { y: -2 }}
                        >
                          <Link
                            href={`/projects/${project.id}`}
                            className="group block rounded-xl border border-[var(--border)] bg-[var(--surface-raised)] p-4 transition-colors hover:border-emerald-500/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
                          >
                            <div className="flex items-start justify-between gap-3">
                              <div className="flex min-w-0 items-start gap-3">
                                <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-emerald-500/15 bg-emerald-500/10 text-emerald-500">
                                  <FolderKanban size={18} />
                                </div>

                                <div className="min-w-0">
                                  <h4 className="break-words font-medium">
                                    {project.name}
                                  </h4>
                                  <p className="mt-1 break-all text-xs text-[var(--muted)]">
                                    {project.base_url ||
                                      "No base URL configured"}
                                  </p>
                                  {project.description && (
                                    <p className="mt-2 text-sm leading-6 text-[var(--muted)]">
                                      {project.description}
                                    </p>
                                  )}
                                </div>
                              </div>

                              <ArrowUpRight
                                size={17}
                                className="shrink-0 text-[var(--muted)] transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-emerald-500"
                              />
                            </div>

                            <div className="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[var(--border)] pt-3 text-xs text-[var(--muted)]">
                              <span className="flex items-center gap-1.5">
                                <Activity
                                  size={13}
                                  className="text-emerald-500"
                                />
                                {analyticsLoading
                                  ? "Loading runs…"
                                  : `${summary?.total_runs ?? 0} runs`}
                              </span>

                              <span className="flex items-center gap-1.5">
                                <CircleAlert
                                  size={13}
                                  className="text-amber-500"
                                />
                                {analyticsLoading
                                  ? "Loading failures…"
                                  : `${summary?.failed_runs ?? 0} failed`}
                              </span>

                              <span className="ml-auto text-emerald-600 transition group-hover:text-emerald-500 dark:text-emerald-300">
                                Open project
                              </span>
                            </div>
                          </Link>
                        </motion.div>
                      );
                    })}
                  </div>
                ) : null}
              </motion.article>

              {/* Recent activity */}
              <motion.article
                id="activity"
                initial={reduceMotion ? false : { opacity: 0, y: 16 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.5, delay: 0.25 }}
                className="min-w-0 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6"
              >
                <p className="mb-1 font-mono text-[10px] uppercase tracking-[0.2em] text-emerald-500">
                  Latest runs
                </p>
                <h3 className="font-semibold">Recent activity</h3>
                <p className="mt-1 text-sm text-[var(--muted)]">
                  Latest test executions by project
                </p>

                <div className="mt-6 space-y-3">
                  {analyticsLoading ? (
                    [1, 2, 3].map((item) => (
                      <div
                        key={item}
                        className="animate-pulse rounded-xl bg-[var(--surface-raised)] p-4"
                      >
                        <div className="h-3 w-2/3 rounded bg-[var(--border)]" />
                        <div className="mt-3 h-3 w-1/2 rounded bg-[var(--border)]" />
                      </div>
                    ))
                  ) : activity.length === 0 ? (
                    <div className="flex min-h-48 flex-col items-center justify-center rounded-xl border border-dashed border-[var(--border)] px-4 text-center">
                      <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--surface-raised)] text-[var(--muted)]">
                        <Clock3 size={20} />
                      </div>
                      <p className="mt-3 text-sm font-medium">
                        No recent test runs
                      </p>
                      <p className="mt-2 text-xs leading-5 text-[var(--muted)]">
                        Run a test case to see project activity here.
                      </p>
                    </div>
                  ) : (
                    activity.map((item, index) => (
                      <motion.div
                        key={`${item.projectId}-${item.lastRunAt}`}
                        initial={reduceMotion ? false : { opacity: 0, x: 10 }}
                        animate={{ opacity: 1, x: 0 }}
                        transition={{
                          duration: 0.3,
                          delay: index * 0.06,
                        }}
                      >
                        <Link
                          href={`/projects/${item.projectId}`}
                          className="group flex gap-3 rounded-xl border border-transparent bg-[var(--surface-raised)] p-4 transition hover:border-emerald-500/30"
                        >
                          <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500">
                            <Activity size={16} />
                          </div>

                          <div className="min-w-0 flex-1">
                            <div className="flex items-start justify-between gap-2">
                              <p className="break-words text-sm font-medium">
                                {item.projectName}
                              </p>
                              <ArrowUpRight
                                size={14}
                                className="shrink-0 text-[var(--muted)] transition group-hover:text-emerald-500"
                              />
                            </div>

                            <p className="mt-1 text-xs leading-5 text-[var(--muted)]">
                              {formatDate(item.lastRunAt)}
                            </p>

                            <div className="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
                              <span className="text-[var(--muted)]">
                                {item.totalRuns} total runs
                              </span>
                              <span
                                className={
                                  item.failedRuns > 0
                                    ? "text-amber-600 dark:text-amber-300"
                                    : "text-emerald-600 dark:text-emerald-300"
                                }
                              >
                                {item.failedRuns} failed
                              </span>
                            </div>
                          </div>
                        </Link>
                      </motion.div>
                    ))
                  )}
                </div>

                <div className="mt-5 flex items-center gap-2 border-t border-[var(--border)] pt-4 text-xs text-[var(--muted)]">
                  <GitCompareArrows size={14} className="text-emerald-500" />
                  Activity is based on available project summaries.
                </div>
              </motion.article>
            </section>

            {/* Footer */}
            <footer className="flex flex-col justify-between gap-3 border-t border-[var(--border)] pt-5 text-xs text-[var(--muted)] sm:flex-row sm:items-center">
              <p>
                TraceIQ · API testing and regression intelligence
              </p>
              <Link
                href="/"
                className="flex w-fit items-center gap-1.5 transition hover:text-emerald-500"
              >
                Back to homepage
                <ArrowUpRight size={13} />
              </Link>
            </footer>
          </div>
        </section>
      </div>
    </main>
    </AuthGuard>
  );
}
